{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunreminder",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "sunreminder-db" }]
}
